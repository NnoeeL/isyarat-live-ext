{
  "manifest_version": 3,
  "name": "Isyarat-Live (SIBI / BISINDO)",
  "version": "1.0.0",
  "description": "Terjemahkan bahasa isyarat Indonesia (SIBI/BISINDO) secara real-time 100% lokal di Umingle, WhatsApp Web, dan Google Meet.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://umingle.com/*",
    "https://*.umingle.com/*",
    "https://web.whatsapp.com/*",
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Isyarat-Live",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://umingle.com/*",
        "https://*.umingle.com/*",
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "wasm/*",
        "models/*",
        "signs/*",
        "signs/words/*",
        "icons/*"
      ],
      "matches": [
        "https://umingle.com/*",
        "https://*.umingle.com/*",
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
